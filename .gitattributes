# Mark mechanically-generated code so GitHub collapses it by default in the
# "Files changed" PR view and excludes it from diff/line-count stats.
# See https://github.blog/changelog/2019-06-24-github-is-generally-available-in-chrome-opera-and-firefox-extensions/
# and https://docs.github.com/repositories/working-with-files/managing-files/customizing-how-changed-files-appear-on-github
api/**/zz_generated.deepcopy.go linguist-generated=true
config/crd/bases/*.yaml linguist-generated=true
pkg/applyconfigurations/**/*.go linguist-generated=true
pkg/generated/**/*.go linguist-generated=true
pkg/generated/**/*.json linguist-generated=true
